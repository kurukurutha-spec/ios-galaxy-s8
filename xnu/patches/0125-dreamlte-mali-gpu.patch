+++ b/iokit/Kernel/arm/MaliGPU.h
@@ -0,0 +1,129 @@
+/*
+ * Mali-G71 GPU driver for Samsung Galaxy S8 (Exynos 8895) - Header
+ *
+ * This driver presents the Mali-G71 GPU as an IOAccelerator-compatible
+ * interface for iOS. It provides GPU access for CoreAnimation/Metal rendering.
+ */
+#ifndef _MALI_GPU_H
+#define _MALI_GPU_H
+
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_A5XELTE) || defined(DREAMLTE)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/c++/OSObject.h>
+
+/* Mali-G71 MP20 hardware registers (Exynos 8895) */
+#define MALI_BASE_ADDR          0x11800000UL
+#define MALI_SIZE               0x5000UL
+
+/* Mali register offsets */
+#define GPU_ID                  0x000
+#define GPU_CONTROL             0x020
+#define GPU_STATUS              0x024
+#define GPU_READY               0x028
+#define GPU_INT_RAWSTAT         0x2C0
+#define GPU_INT_CLEAR           0x2C4
+#define GPU_INT_MASK            0x2C8
+#define GPU_INT_STAT            0x2CC
+
+/* Job slot registers */
+#define JOB_SLOT_BASE           0x800
+#define JS_HEAD_NEXT_LO         0x000
+#define JS_HEAD_NEXT_HI         0x004
+#define JS_TAIL_NEXT_LO         0x008
+#define JS_TAIL_NEXT_HI         0x00C
+#define JS_AFFINITY_NEXT_LO     0x010
+#define JS_AFFINITY_NEXT_HI     0x014
+#define JS_CONFIG_NEXT          0x018
+#define JS_COMMAND_NEXT         0x020
+#define JS_STATUS               0x024
+
+/* GPU commands */
+#define GPU_CMD_SOFT_RESET      0x01
+#define GPU_CMD_HARD_RESET      0x02
+#define GPU_CMD_CLEAR_FAULT     0x04
+
+/* Job commands */
+#define JS_CMD_NOOP             0x00
+#define JS_CMD_START            0x01
+#define JS_CMD_SOFT_STOP        0x02
+#define JS_CMD_HARD_STOP        0x03
+#define JS_CMD_FLUSH_CACHE      0x04
+
+#define MALI_NUM_JOB_SLOTS      3
+#define MALI_MAX_CONTEXTS       256
+
+/*
+ * MaliGPU - Main GPU driver service
+ */
+class MaliGPU : public IOService {
+    OSDeclareDefaultStructors(MaliGPU);
+
+public:
+    virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+
+    /* Hardware control */
+    bool initHardware();
+    void resetGPU();
+    uint32_t readReg(uint32_t offset);
+    void writeReg(uint32_t offset, uint32_t value);
+
+    /* Interrupt handling */
+    static void interruptHandler(OSObject *owner, IOService *provider, int source);
+    void handleInterrupt();
+
+    /* Job management */
+    bool submitJob(uint32_t slot, uint64_t jobDescriptor, uint64_t affinity);
+
+private:
+    IOMemoryMap *gpuRegs;
+    volatile uint32_t *regBase;
+    IOWorkLoop *workLoop;
+    IOInterruptEventSource *interruptSource;
+    IOLock *hardwareLock;
+
+    uint32_t gpuID;
+    bool powerOn;
+};
+
+/*
+ * MaliGPUUserClient - User space interface
+ */
+class MaliGPUUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(MaliGPUUserClient);
+
+public:
+    virtual bool initWithTask(task_t owningTask, void *securityToken, UInt32 type,
+                             OSDictionary *properties) APPLE_KEXT_OVERRIDE;
+    virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+    virtual IOReturn clientClose() APPLE_KEXT_OVERRIDE;
+
+    virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+                                   IOExternalMethodDispatch *dispatch,
+                                   OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+
+protected:
+    static IOReturn sGetGPUInfo(MaliGPUUserClient *target, void *ref,
+                               IOExternalMethodArguments *args);
+    static IOReturn sAllocateContext(MaliGPUUserClient *target, void *ref,
+                                    IOExternalMethodArguments *args);
+    static IOReturn sSubmitJob(MaliGPUUserClient *target, void *ref,
+                              IOExternalMethodArguments *args);
+    static IOReturn sMapMemory(MaliGPUUserClient *target, void *ref,
+                              IOExternalMethodArguments *args);
+
+private:
+    MaliGPU *gpu;
+    task_t clientTask;
+    uint32_t contextID;
+};
+
+#endif /* ARM64_BOARD_CONFIG_A5XELTE || DREAMLTE */
+#endif /* _MALI_GPU_H */
