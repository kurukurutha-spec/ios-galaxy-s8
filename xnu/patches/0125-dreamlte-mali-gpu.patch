diff --git a/osfmk/arm64/dreamlte_mali.c b/osfmk/arm64/dreamlte_mali.c
new file mode 100644
index 0000000..cfc2ebf
--- /dev/null
+++ b/osfmk/arm64/dreamlte_mali.c
@@ -0,0 +1,526 @@
+/*
+ * Mali-G71 MP20 kernel driver for Samsung Galaxy S8 (Exynos 8895)
+ *
+ * Adapted from Scion Project's hakios.mali.c (Exynos 9810/Mali-G72 MP18)
+ * Source: github.com/Scion-Project/scion-kernel (drivers/gpu/mali/hakios.mali.c)
+ * License: Apple Public Source License 2.0 (as original)
+ *
+ * Hardware differences from S9:
+ * - Mali base:  0x13900000 (E8895) vs 0x17500000 (E9810)
+ * - CMU_G3D:    0x14AA0000 (E8895) vs 0x17400000 (E9810)
+ * - PMU G3D:    0x16484000 (E8895) vs 0x16484040 (E9810)
+ * - GPU:        Mali-G71 MP20 (20 cores) vs Mali-G72 MP18 (18 cores)
+ * - PMIC:       S2MPS17 (E8895) vs S2MPS18 (E9810)
+ */
+
+#include <pexpert/pexpert.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/kalloc.h>
+#include <mach/mach_time.h>
+#include <mach/mach_types.h>
+#include <arm/pmap/pmap.h>	/* kvtophys, phystokv: not reached through <vm/pmap.h> */
+
+/* osfmk cannot take <sys/systm.h>: it redefines daddr_t, dev_t, clock_t */
+extern int printf(const char *, ...);
+#include <vm/vm_kern.h>
+
+/* Exynos 8895 hardware addresses */
+#define MALI_PA                 0x13900000UL
+#define MALI_SIZE               0x5000
+#define PMU_PA                  0x16480000UL
+#define PMU_SIZE                0x5000
+#define PMU_G3D_CFG             0x4000
+#define PMU_G3D_STATUS          0x4004
+#define G3D_ON                  0xFu
+#define CMU_G3D_PA              0x14AA0000UL
+#define CMU_G3D_SIZE            0x2000
+
+/* Mali Bifrost (G71/G72) register offsets - universal */
+#define GPU_ID                  0x000
+#define GPU_L2_FEATURES         0x004
+#define GPU_CORE_FEATURES       0x008
+#define GPU_TILER_FEATURES      0x00c
+#define GPU_MEM_FEATURES        0x010
+#define GPU_MMU_FEATURES        0x014
+#define GPU_AS_PRESENT          0x018
+#define GPU_JS_PRESENT          0x01c
+#define GPU_INT_RAWSTAT         0x020
+#define GPU_INT_CLEAR           0x024
+#define GPU_INT_MASK            0x028
+#define GPU_CMD                 0x030
+
+#define SHADER_PRESENT          0x100
+#define SHADER_PRESENT_HI       0x104
+#define TILER_PRESENT           0x110
+#define L2_PRESENT              0x120
+#define SHADER_READY            0x140
+#define TILER_READY             0x150
+#define L2_READY                0x160
+#define SHADER_PWRON            0x180
+#define TILER_PWRON             0x190
+#define L2_PWRON                0x1a0
+
+#define COHERENCY_FEATURES      0x300
+#define COHERENCY_ENABLE        0x304
+#define COHERENCY_NONE          31u
+
+#define GPU_JM_CONFIG           0xf00
+#define GPU_SHADER_CONFIG       0xf04
+#define GPU_TILER_CONFIG        0xf08
+#define GPU_L2_MMU_CONFIG       0xf0c
+#define L2_MMU_LIMIT_EXTERNAL   (0xfu << 24)
+
+/* Job slot registers */
+#define JS0                     0x1800
+#define JS1                     0x1880
+#define JS_STATUS               0x24
+#define JS_HEAD_NEXT_LO         0x40
+#define JS_HEAD_NEXT_HI         0x44
+#define JS_AFFINITY_NEXT_LO     0x50
+#define JS_AFFINITY_NEXT_HI     0x54
+#define JS_CONFIG_NEXT          0x58
+#define JS_COMMAND_NEXT         0x60
+#define JS_CONFIG               ((3u << 8) | (3u << 12) | (8u << 16))
+
+/* Address space 0 */
+#define AS0                     0x2400
+#define AS_TRANSTAB_LO          0x00
+#define AS_TRANSTAB_HI          0x04
+#define AS_MEMATTR_LO           0x08
+#define AS_MEMATTR_HI           0x0c
+#define AS_COMMAND              0x18
+#define AS_FAULTSTATUS          0x1c
+#define AS_STATUS               0x28
+#define AS_ACTIVE               1u
+#define AS_TRANSCFG_LO          0x30
+#define AS_TRANSCFG_HI          0x34
+
+/* GPU commands */
+#define GPU_CMD_SOFT_RESET      1u
+#define GPU_CMD_HARD_RESET      2u
+#define IRQ_RESET_COMPLETED     (1u << 8)
+
+#define RESET_WAIT_US           100000
+#define CORES_WAIT_US           50000
+#define AS_WAIT_US              50000
+
+/* Page table constants */
+#define PTE_TABLE               3ull
+#define PTE_PAGE                3ull
+#define PTE_AF                  (1ull << 10)
+#define PTE_SH_INNER            (3ull << 8)
+#define PTE_AP_RW               (1ull << 6)
+#define PTE_ADDRESS             0x0000fffffffff000ull
+#define GPU_VA_BITS             35u
+#define TRANSCFG_AARCH64        6u
+#define TRANSCFG_INA(bits)      ((55u - (bits)) << 6)
+
+/* Global state */
+static vm_offset_t pmu, cmu_g3d, mali;
+static uint32_t gpu_id, shader_mask, l2_mask;
+static uint64_t *pt_top;
+static uint64_t pt_top_phys, pt_transtab;
+static uint32_t pt_gpu_bits = GPU_VA_BITS;
+static bool gpu_ready;
+
+static LCK_GRP_DECLARE(mali_lock_group, "dreamlte-mali");
+static LCK_MTX_DECLARE(mali_lock, &mali_lock_group);
+static LCK_MTX_DECLARE(mali_job_lock, &mali_lock_group);
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Forward declarations for IOKit C++ */
+void dreamlte_mali_init(void);
+bool dreamlte_mali_ready(void);
+bool dreamlte_mali_parameter(uint32_t which, uint64_t *value);
+uint64_t dreamlte_mali_address(uint64_t size, bool executable);
+bool dreamlte_mali_map(uint64_t gpu, uint64_t phys);
+void dreamlte_mali_mapped(void);
+void dreamlte_mali_unmap(uint64_t gpu, uint64_t size);
+uint32_t dreamlte_mali_submit(uint64_t chain, bool fragment);
+uint64_t dreamlte_mali_enqueue(uint64_t chain, bool fragment);
+bool dreamlte_mali_wait(uint64_t seq, uint64_t timeout_ns);
+
+/* Helper functions */
+static inline uint32_t rd(vm_offset_t base, uint32_t at) {
+    return *(volatile uint32_t *)(base + at);
+}
+
+static inline void wr(vm_offset_t base, uint32_t at, uint32_t value) {
+    *(volatile uint32_t *)(base + at) = value;
+    __asm__ volatile ("dsb sy");
+}
+
+static bool wait_for(vm_offset_t base, uint32_t at, uint32_t mask, uint32_t want, uint32_t us) {
+    uint64_t deadline;
+    nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &deadline);
+    deadline += mach_absolute_time();
+    while ((rd(base, at) & mask) != want) {
+        if (mach_absolute_time() >= deadline) {
+            return (rd(base, at) & mask) == want;
+        }
+    }
+    return true;
+}
+
+/* GPU reset */
+static bool gpu_reset(void) {
+    wr(mali, GPU_INT_MASK, 0);
+    wr(mali, GPU_INT_CLEAR, IRQ_RESET_COMPLETED);
+    wr(mali, GPU_CMD, GPU_CMD_SOFT_RESET);
+    if (!wait_for(mali, GPU_INT_RAWSTAT, IRQ_RESET_COMPLETED, IRQ_RESET_COMPLETED, RESET_WAIT_US)) {
+        printf("dreamlte_mali: soft reset failed, trying hard reset\n");
+        wr(mali, GPU_CMD, GPU_CMD_HARD_RESET);
+        if (!wait_for(mali, GPU_INT_RAWSTAT, IRQ_RESET_COMPLETED, IRQ_RESET_COMPLETED, RESET_WAIT_US)) {
+            return false;
+        }
+    }
+    wr(mali, GPU_INT_CLEAR, 0xffffffffu);
+    wr(mali, COHERENCY_ENABLE, COHERENCY_NONE);
+    wr(mali, GPU_L2_MMU_CONFIG, rd(mali, GPU_L2_MMU_CONFIG) & ~L2_MMU_LIMIT_EXTERNAL);
+    return true;
+}
+
+/* Power on cores: L2 -> shaders -> tiler */
+static bool gpu_cores_on(const char **which) {
+    uint32_t tiler = rd(mali, TILER_PRESENT);
+
+    wr(mali, L2_PWRON, l2_mask);
+    if (!wait_for(mali, L2_READY, l2_mask, l2_mask, CORES_WAIT_US)) {
+        *which = "L2";
+        return false;
+    }
+
+    wr(mali, SHADER_PWRON, shader_mask);
+    if (!wait_for(mali, SHADER_READY, shader_mask, shader_mask, CORES_WAIT_US)) {
+        *which = "shader cores";
+        return false;
+    }
+
+    wr(mali, TILER_PWRON, tiler);
+    if (!wait_for(mali, TILER_READY, tiler, tiler, CORES_WAIT_US)) {
+        *which = "tiler";
+        return false;
+    }
+
+    return true;
+}
+
+/* Page table management */
+static uint64_t *pt_page(uint64_t *phys) {
+    vm_offset_t page = 0;
+    if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+        return NULL;
+    }
+    *phys = kvtophys(page);
+    if (*phys == 0) {
+        kmem_free(kernel_map, page, PAGE_SIZE);
+        return NULL;
+    }
+    return (uint64_t *)page;
+}
+
+static uint64_t *table_of(uint64_t entry) {
+    uint64_t phys = entry & PTE_ADDRESS;
+    if (!(entry & 1) || phys == 0) {
+        return NULL;
+    }
+    return (uint64_t *)phystokv(phys);
+}
+
+static uint64_t *pt_below(uint64_t *entry) {
+    uint64_t phys;
+    uint64_t *table;
+
+    if (*entry & 1) {
+        return table_of(*entry);
+    }
+    table = pt_page(&phys);
+    if (table == NULL) {
+        return NULL;
+    }
+    *entry = phys | PTE_TABLE;
+    return table;
+}
+
+static bool map_page(uint64_t gpu, uint64_t phys) {
+    uint64_t *middle, *bottom, *entry;
+
+    if (gpu >= (1ull << GPU_VA_BITS)) {
+        return false;
+    }
+    if (phys == 0) {
+        return false;
+    }
+    if (pt_top == NULL && (pt_top = pt_page(&pt_top_phys)) == NULL) {
+        return false;
+    }
+    pt_transtab = pt_top_phys;
+
+    if ((middle = pt_below(&pt_top[(gpu >> 30) & 31])) == NULL ||
+        (bottom = pt_below(&middle[(gpu >> 21) & 511])) == NULL) {
+        return false;
+    }
+
+    entry = &bottom[(gpu >> 12) & 511];
+    *entry = (phys & PTE_ADDRESS) | PTE_AF | PTE_SH_INNER | PTE_AP_RW | PTE_PAGE;
+    return true;
+}
+
+static void unmap_pages(uint64_t gpu, uint64_t size) {
+    if (pt_top == NULL) {
+        return;
+    }
+    for (uint64_t at = gpu; at < gpu + size; at += 4096) {
+        uint64_t *table = table_of(pt_top[(at >> 30) & 31]), *entry;
+        if (table == NULL) continue;
+        table = table_of(table[(at >> 21) & 511]);
+        if (table == NULL) continue;
+        entry = &table[(at >> 12) & 511];
+        *entry = 0;
+    }
+}
+
+static void as0_update(uint64_t transtab, uint32_t transcfg) {
+    (void)wait_for(mali, AS0 + AS_STATUS, AS_ACTIVE, 0, AS_WAIT_US);
+    wr(mali, AS0 + AS_TRANSTAB_LO, (uint32_t)transtab);
+    wr(mali, AS0 + AS_TRANSTAB_HI, (uint32_t)(transtab >> 32));
+    wr(mali, AS0 + AS_TRANSCFG_LO, transcfg);
+    wr(mali, AS0 + AS_TRANSCFG_HI, 0);
+    wr(mali, AS0 + AS_MEMATTR_LO, 0x88888888u);
+    wr(mali, AS0 + AS_MEMATTR_HI, 0x88888888u);
+    wr(mali, AS0 + AS_COMMAND, 1);
+    (void)wait_for(mali, AS0 + AS_STATUS, AS_ACTIVE, 0, AS_WAIT_US);
+}
+
+static inline uint32_t pt_transcfg(void) {
+    return TRANSCFG_AARCH64 | TRANSCFG_INA(pt_gpu_bits);
+}
+
+/* Job submission (simplified for kernel-level) */
+static uint64_t mali_done_seq;
+
+uint32_t dreamlte_mali_submit(uint64_t chain, bool fragment) {
+    uint32_t slot = fragment ? 0 : 1, js = fragment ? JS0 : JS1;
+    bool finished;
+
+    lck_mtx_lock(&mali_job_lock);
+    lck_mtx_lock(&mali_lock);
+    wr(mali, js + JS_HEAD_NEXT_LO, (uint32_t)chain);
+    wr(mali, js + JS_HEAD_NEXT_HI, (uint32_t)(chain >> 32));
+    wr(mali, js + JS_AFFINITY_NEXT_LO, shader_mask);
+    wr(mali, js + JS_AFFINITY_NEXT_HI, 0);
+    wr(mali, js + JS_CONFIG_NEXT, JS_CONFIG);
+    wr(mali, js + JS_COMMAND_NEXT, 1);
+    lck_mtx_unlock(&mali_lock);
+
+    /* Simple polling wait for completion */
+    finished = wait_for(mali, js + JS_STATUS, 0x1, 0, 1000000);
+
+    lck_mtx_lock(&mali_lock);
+    uint32_t status = finished ? 0 : rd(mali, js + JS_STATUS);
+    lck_mtx_unlock(&mali_lock);
+    lck_mtx_unlock(&mali_job_lock);
+
+    return status;
+}
+
+uint64_t dreamlte_mali_enqueue(uint64_t chain, bool fragment) {
+    dreamlte_mali_submit(chain, fragment);
+    return ++mali_done_seq;
+}
+
+bool dreamlte_mali_wait(uint64_t seq, uint64_t timeout_ns) {
+    /* Simplified: jobs run synchronously */
+    return mali_done_seq >= seq;
+}
+
+/* Public API for IOKit */
+bool dreamlte_mali_ready(void) {
+    return gpu_ready;
+}
+
+bool dreamlte_mali_parameter(uint32_t which, uint64_t *value) {
+    if (!gpu_ready) return false;
+
+    switch (which) {
+    case 0: *value = gpu_id >> 16; return true;
+    case 1: *value = gpu_id & 0xffff; return true;
+    case 2: *value = rd(mali, SHADER_PRESENT) | ((uint64_t)rd(mali, SHADER_PRESENT_HI) << 32); return true;
+    case 3: *value = rd(mali, TILER_PRESENT); return true;
+    case 4: *value = rd(mali, L2_PRESENT); return true;
+    case 38: *value = __builtin_popcount(l2_mask) ? (uint64_t)__builtin_popcount(l2_mask) : 1; return true;
+    default:
+        if (which >= 5 && which <= 21) {
+            static const uint16_t offsets[] = {
+                0x018, 0x01c, 0x004, 0x008, 0x00c, 0x010, 0x014,
+                0x0ac, 0x0a0, 0x0a4, 0x0a8, 0x300,
+                0x0b0, 0x0b4, 0x0b8, 0x0bc
+            };
+            if (which - 5 < sizeof(offsets)/sizeof(offsets[0])) {
+                *value = rd(mali, offsets[which - 5]);
+                return true;
+            }
+        }
+        return false;
+    }
+}
+
+uint64_t dreamlte_mali_address(uint64_t size, bool executable) {
+    /* Simplified address allocation: 32MB-4GB range */
+    static uint64_t next_addr = 0x02000000; // 32MB
+    uint64_t addr;
+
+    lck_mtx_lock(&mali_lock);
+    addr = next_addr;
+    next_addr += round_page_64(size);
+    if (next_addr >= 0x100000000ULL) {
+        addr = 0; // Out of space
+    }
+    lck_mtx_unlock(&mali_lock);
+
+    return addr;
+}
+
+bool dreamlte_mali_map(uint64_t gpu, uint64_t phys) {
+    bool done;
+    lck_mtx_lock(&mali_lock);
+    done = map_page(gpu, phys);
+    lck_mtx_unlock(&mali_lock);
+    return done;
+}
+
+void dreamlte_mali_mapped(void) {
+    lck_mtx_lock(&mali_job_lock);
+    lck_mtx_lock(&mali_lock);
+    as0_update(pt_transtab, pt_transcfg());
+    lck_mtx_unlock(&mali_lock);
+    lck_mtx_unlock(&mali_job_lock);
+}
+
+void dreamlte_mali_unmap(uint64_t gpu, uint64_t size) {
+    lck_mtx_lock(&mali_lock);
+    unmap_pages(gpu, size);
+    lck_mtx_unlock(&mali_lock);
+
+    lck_mtx_lock(&mali_job_lock);
+    lck_mtx_lock(&mali_lock);
+    as0_update(pt_transtab, pt_transcfg());
+    lck_mtx_unlock(&mali_lock);
+    lck_mtx_unlock(&mali_job_lock);
+}
+
+/* Hardware initialization */
+void dreamlte_mali_init(void) {
+    uint32_t last_step = 0;
+    const char *which;
+
+    /* Check boot-arg */
+    if (!PE_parse_boot_argn("mali", &last_step, sizeof(last_step)) || last_step == 0) {
+        printf("dreamlte_mali: mali=N not set, GPU disabled\n");
+        return;
+    }
+
+    printf("dreamlte_mali: Exynos 8895 Mali-G71 MP20 init (steps 1-%u)\n", last_step);
+
+    /* Step 1: Map registers */
+    pmu = ml_io_map(PMU_PA, PMU_SIZE);
+    cmu_g3d = ml_io_map(CMU_G3D_PA, CMU_G3D_SIZE);
+    mali = ml_io_map(MALI_PA, MALI_SIZE);
+
+    if (!pmu || !cmu_g3d || !mali) {
+        printf("dreamlte_mali: register mapping failed\n");
+        return;
+    }
+
+    printf("dreamlte_mali: 1: registers mapped (PMU=0x%lx, CMU=0x%lx, Mali=0x%lx)\n",
+           (unsigned long)pmu, (unsigned long)cmu_g3d, (unsigned long)mali);
+
+    if (last_step < 2) goto done;
+
+    /* Step 2: Power domain */
+    uint32_t status = rd(pmu, PMU_G3D_STATUS);
+    printf("dreamlte_mali: 2: G3D domain status=0x%x\n", status);
+
+    if ((status & G3D_ON) != G3D_ON) {
+        printf("dreamlte_mali: 2: powering on G3D domain\n");
+        wr(pmu, PMU_G3D_CFG, G3D_ON);
+        if (!wait_for(pmu, PMU_G3D_STATUS, G3D_ON, G3D_ON, 100000)) {
+            printf("dreamlte_mali: 2: FAILED to power on G3D\n");
+            return;
+        }
+        printf("dreamlte_mali: 2: G3D domain powered on\n");
+    }
+
+    if (last_step < 3) goto done;
+
+    /* Step 3: Read GPU ID */
+    gpu_id = rd(mali, GPU_ID);
+    printf("dreamlte_mali: 3: GPU_ID=0x%08x (arch %u.%u, product %u, r%up%u)\n",
+           gpu_id, gpu_id >> 28, (gpu_id >> 24) & 0xf, (gpu_id >> 16) & 0xf,
+           (gpu_id >> 12) & 0xf, (gpu_id >> 4) & 0xff);
+
+    if (((gpu_id >> 16) & 0xFF00) != 0x6000) {
+        printf("dreamlte_mali: 3: not a Mali Bifrost GPU\n");
+        return;
+    }
+
+    shader_mask = rd(mali, SHADER_PRESENT);
+    l2_mask = rd(mali, L2_PRESENT);
+    printf("dreamlte_mali: 3: %u shader cores (mask=0x%x), L2 mask=0x%x\n",
+           __builtin_popcount(shader_mask), shader_mask, l2_mask);
+
+    if (last_step < 4) goto done;
+
+    /* Step 4: Reset */
+    printf("dreamlte_mali: 4: GPU reset\n");
+    if (!gpu_reset()) {
+        printf("dreamlte_mali: 4: FAILED reset\n");
+        return;
+    }
+
+    if (last_step < 5) goto done;
+
+    /* Step 5: Power on cores */
+    printf("dreamlte_mali: 5: powering on cores (L2->shaders->tiler)\n");
+    if (!gpu_cores_on(&which)) {
+        printf("dreamlte_mali: 5: FAILED to power on %s\n", which);
+        return;
+    }
+    printf("dreamlte_mali: 5: all cores powered on\n");
+
+    if (last_step < 6) goto done;
+
+    /* Step 6: Initialize page tables */
+    printf("dreamlte_mali: 6: initializing page tables (AArch64, 4KB, 3 levels)\n");
+    if (pt_top == NULL && (pt_top = pt_page(&pt_top_phys)) == NULL) {
+        printf("dreamlte_mali: 6: FAILED to allocate page tables\n");
+        return;
+    }
+    pt_transtab = pt_top_phys;
+    as0_update(pt_transtab, pt_transcfg());
+    printf("dreamlte_mali: 6: AS0 configured (transtab=0x%llx)\n", pt_transtab);
+
+    if (last_step < 7) goto done;
+
+    /* Step 7: Basic job test would go here */
+    printf("dreamlte_mali: 7: basic test job (skipped in kernel init)\n");
+
+    if (last_step < 8) goto done;
+
+    /* Step 8: Mark ready for IOKit */
+    gpu_ready = true;
+    printf("dreamlte_mali: 8: Mali-G71 MP20 ready for IOKit service\n");
+
+done:
+    printf("dreamlte_mali: init completed (reached step %u of %u)\n",
+           last_step < 8 ? last_step : 8, last_step);
+}
+
+#ifdef __cplusplus
+}
+#endif
